theorem repairedValid : ((rows repaired).map Prod.fst).Nodup ∧
    (rows repaired).length = 107 ∧
    ∀ r ∈ rows repaired, 1 < r.1 ∧ r.1 ∣ 3867500 := by decide

theorem complete (x : Int) : ∃ r ∈ rows repaired, x % (r.1 : Int) = (r.2 : Int) :=
  allIntegers (N := 3867500) (by decide) (by decide)
    (fun r h => (repairedValid.2.2 r h).2) x

theorem originalOnlyMisses (x : Int) :
    (∃ r ∈ original, x % (r.1 : Int) = (r.2 : Int)) ∨
    ∃ h ∈ exceptions, x % 773500 = (h : Int) := by
  have h : ∀ r ∈ rows withExceptions, r ∈ original ∨ r.1 = 773500 ∧ r.2 ∈ exceptions := by decide
  obtain ⟨r,hr,hx⟩ := allIntegers (N := 773500) (by decide) (by decide)
    (stages := withExceptions) (by decide) x
  rcases h r hr with h | ⟨hm,he⟩
  · exact Or.inl ⟨r,h,hx⟩
  · rw [hm] at hx
    exact Or.inr ⟨r.2,he,hx⟩

theorem originalMissesAllEight :
    exceptions.Nodup ∧ exceptions.length = 8 ∧
    ∀ h ∈ exceptions, h < 773500 ∧ ∀ r ∈ original, h % r.1 ≠ r.2 := by decide

